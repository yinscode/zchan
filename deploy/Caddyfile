# The landing page at /, the judge playground at /play (its API under /api/).
# Both pages are plain files, so page edits need no restart. Only the playground's
# API is public; the solver and merchants stay on localhost.
{$ZCHAN_DOMAIN} {
	encode zstd gzip
	handle /api/* {
		reverse_proxy 127.0.0.1:8088
	}
	handle /play {
		root * /var/www/zchan
		rewrite * /play.html
		file_server
	}
	handle {
		root * /var/www/zchan
		file_server
	}
}
